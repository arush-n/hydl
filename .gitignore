# Ignore rules that are always true for this project, regardless of who is
# working on it. Anything specific to one machine, one contributor, or one
# unpublished subproject belongs in .git/info/exclude instead, which is local
# to a clone and never committed.
#
# This file must stay tracked. `tools/check_publication_hygiene.py` pins it as
# MUST_BE_TRACKABLE: a clone that inherits no ignore rules can stage decompiled
# sources, jars and server installs on the next `git add -A`.

# --- Build output -----------------------------------------------------------
hytale-plugin/build/
hytale-plugin/.gradle/
*.class
*.jar
!hytale-plugin/gradle/wrapper/gradle-wrapper.jar
dist/
build/
out/
out-hook/
**/out/
**/out-hook/
*.egg-info/
.eggs/
*.egg

# --- Python -----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version

# --- Caches -----------------------------------------------------------------
.cache/
**/.cache/
.jax_cache/
.jax-cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pyright/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Environments -----------------------------------------------------------
.env
.venv/
venv/
.tools/

# --- Editors and OS ---------------------------------------------------------
.idea/
.vscode/
*.iml
.project
.classpath
.settings/
.DS_Store
Thumbs.db
Desktop.ini

